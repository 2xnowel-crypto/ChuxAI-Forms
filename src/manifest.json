{
  "manifest_version": 3,
  "name": "ChuxAI V2",
  "version": "4.0.0",
  "description": "Asistente local con Ollama y Qwen. Gestiona preguntas de respuesta única, selección múltiple y respuesta escrita en Google Forms.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/forms/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "ChuxAI V2"
  }
}
